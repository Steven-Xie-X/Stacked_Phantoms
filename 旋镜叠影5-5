  }

  function sanitizeSnapshot(snap) {
    if (!Array.isArray(snap)) return [];
    return snap.map(s => ({
      cells: Array.isArray(s.cells) ? s.cells.map(c => [c[0], c[1]]) : [],
      h: s.h, w: s.w, placed: !!s.placed, row: s.row || 0, col: s.col || 0
    }));
  }

  function saveProgress() {
    if (!currentSeed) return;
    if (answerMode) return;
    const data = {
      seed: currentSeed,
      mode: digitalMode ? 'num' : 'bw',
      color: colorMode,
      isRandom: isRandomChallenge,
      solved: solved,
      abandoned: abandoned,
      pendingResetStreak: resetStreakOnNextSolve,
      startTime: challengeStartTime,
      solvedElapsed: solvedElapsed,
      pieces: pieces.map(p => ({
        cells: p.cells.map(c => [c[0], c[1]]),
        h: p.h, w: p.w, placed: p.placed, row: p.row, col: p.col
      })),
      undoStack: undoStack.slice(-MAX_UNDO),
      redoStack: redoStack.slice(-MAX_UNDO),
      saved: Date.now()
    };
    setProgressForMode(gameTypeKey, data);
  }
  let saveTimer = null;
  function scheduleSaveProgress() {
    if (saveTimer) clearTimeout(saveTimer);
    saveTimer = setTimeout(saveProgress, 250);
  }

  function loadProgressForCurrentMode() {
    const data = getProgressForMode(gameTypeKey);
    if (!data || !data.seed) return false;
    try {
      generateChallenge(data.seed, true, data.isRandom !== false);
      if (data.pieces && data.pieces.length === pieces.length) {
        for (let i = 0; i < pieces.length; i++) {
          const s = data.pieces[i];
          if (!s || !s.cells) continue;
          pieces[i].cells = s.cells.map(c => [c[0], c[1]]);
          pieces[i].h = s.h; pieces[i].w = s.w;
          pieces[i].placed = !!s.placed;
          pieces[i].row = s.row || 0; pieces[i].col = s.col || 0;
        }
      }
      digitalMode = data.mode === 'num';
      colorMode = !!data.color;
      solved = !!data.solved;
      abandoned = !!data.abandoned;
      resetStreakOnNextSolve = !!data.pendingResetStreak;
      undoStack = sanitizeSnapshot(data.undoStack).slice(-MAX_UNDO);
      redoStack = sanitizeSnapshot(data.redoStack).slice(-MAX_UNDO);

      if (gameMode === 'challenge' && (solved || abandoned)) {
        seedShow.textContent = currentSeed;
      }

      if (data.startTime && !solved && !abandoned) {
        challengeStartTime = data.startTime;
        timerRow.style.display = 'flex';
        updateTimerDisplay();
        timerInterval = setInterval(updateTimerDisplay, 1000);
      } else if (data.startTime) {
        solvedElapsed = data.solvedElapsed || 0;
        challengeStartTime = data.startTime;
        timerRow.style.display = 'flex';
        if (solved) {
          timerDisplay.textContent = formatTimer(solvedElapsed);
        } else {
          timerDisplay.textContent = formatTimer(
            Math.floor((data.saved - data.startTime) / 1000)
          );
        }
      } else {
        timerRow.style.display = 'none';
      }

      renderAll();
      return true;
    } catch (e) {
      console.error('恢复进度失败:', e);
      return false;
    }
  }

  function pickNewSeed() {
    const solvedSeeds = getAllSolvedSeeds();
    if (solvedSeeds.size < 5000) {
      let seed, attempts = 0;
      do {
        seed = Math.floor(Math.random() * 100000) + 1;
        attempts++;
      } while (solvedSeeds.has(seed) && attempts < 800);
      if (!solvedSeeds.has(seed)) return seed;
    }
    const candidates = [];
    for (let i = 1; i <= 100000; i++) {
      if (!solvedSeeds.has(i)) candidates.push(i);
    }
    if (candidates.length === 0) {
      return Math.floor(Math.random() * 100000) + 1;
    }
    return candidates[Math.floor(Math.random() * candidates.length)];
  }

  function mulberry32(a) {
    return function () {
      a |= 0; a = a + 0x6D2B79F5 | 0;
      let t = Math.imul(a ^ a >>> 15, 1 | a);
      t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    };
  }
  function randomShape(rng) {
    const size = 3 + Math.floor(rng() * 3);
    const cells = [[0, 0]];
    const set = new Set(['0,0']);
    const dirs = [[0, 1], [1, 0], [0, -1], [-1, 0]];
    let guard = 0;
    while (cells.length < size && guard++ < 500) {
      const base = cells[Math.floor(rng() * cells.length)];
      const d = dirs[Math.floor(rng() * 4)];
      const nr = base[0] + d[0], nc = base[1] + d[1];
      const key = nr + ',' + nc;
      if (!set.has(key)) { set.add(key); cells.push([nr, nc]); }
    }
    const minR = Math.min(...cells.map(c => c[0]));
    const minC = Math.min(...cells.map(c => c[1]));
    return cells.map(([r, c]) => [r - minR, c - minC])
      .sort((a, b) => a[0] - b[0] || a[1] - b[1]);
  }
  function normalize(cells) {
    const minR = Math.min(...cells.map(c => c[0]));
    const minC = Math.min(...cells.map(c => c[1]));
    const nc = cells.map(([r, c]) => [r - minR, c - minC]);
    nc.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    return nc;
  }
  function rotate90(cells) {
    const maxR = Math.max(...cells.map(c => c[0]));
    return normalize(cells.map(([r, c]) => [c, maxR - r]));
  }
  function rotateCCW(cells) {
    const maxC = Math.max(...cells.map(c => c[1]));
    return normalize(cells.map(([r, c]) => [maxC - c, r]));
  }
  function mirror(cells) {
    const maxC = Math.max(...cells.map(c => c[1]));
    return normalize(cells.map(([r, c]) => [r, maxC - c]));
  }
  function applyTransform(baseCells, rot, flip) {
    let cells = baseCells.map(([r, c]) => [r, c]);
    for (let i = 0; i < rot; i++) {
      const maxR = Math.max(...cells.map(c => c[0]));
      cells = cells.map(([r, c]) => [c, maxR - r]);
    }
    if (flip) {
      const maxC = Math.max(...cells.map(c => c[1]));
      cells = cells.map(([r, c]) => [r, maxC - c]);
    }
    return normalize(cells);
  }
  function shapeSize(cells) {
    return {
      h: Math.max(...cells.map(c => c[0])) + 1,
      w: Math.max(...cells.map(c => c[1])) + 1
    };
  }

  function computeGrid(list) {
    const g = Array.from({ length: N }, () => new Array(N).fill(0));
    for (const p of list) {
      if (!p.placed) continue;
      for (const [r, c] of p.cells) {
        const rr = p.row + r, cc = p.col + c;
        if (rr >= 0 && rr < N && cc >= 0 && cc < N) g[rr][cc] ^= 1;
      }
    }
    return g;
  }
  function computeAnswerGrid(count) {
    const g = Array.from({ length: N }, () => new Array(N).fill(0));
    const lim = Math.min(count, answerPlacements.length);
    for (let i = 0; i < lim; i++) {
      const ap = answerPlacements[i];
      for (const [r, c] of ap.cells) {
        const rr = ap.row + r, cc = ap.col + c;
        if (rr >= 0 && rr < N && cc >= 0 && cc < N) g[rr][cc] ^= 1;
      }
    }
    return g;
  }
  function computeNumberGridPlayer() {
    const g = Array.from({ length: N }, () => new Array(N).fill(0));
    for (const p of pieces) {
      if (!p.placed) continue;
      const d = p.digit;
      for (const [r, c] of p.cells) {
        const rr = p.row + r, cc = p.col + c;
        if (rr >= 0 && rr < N && cc >= 0 && cc < N) g[rr][cc] += d;
      }
    }
    return g;
  }
  function computeNumberGridAnswer(count) {
    const g = Array.from({ length: N }, () => new Array(N).fill(0));
    const lim = Math.min(count, answerPlacements.length);
    for (let i = 0; i < lim; i++) {
      const ap = answerPlacements[i];
      const d = pieces[i] ? pieces[i].digit : 0;
      for (const [r, c] of ap.cells) {
        const rr = ap.row + r, cc = ap.col + c;
        if (rr >= 0 && rr < N && cc >= 0 && cc < N) g[rr][cc] += d;
      }
    }
    return g;
  }

  function snapshotPieces() {
    return pieces.map(p => ({
      cells: p.cells.map(c => [c[0], c[1]]),
      h: p.h, w: p.w, placed: p.placed, row: p.row, col: p.col
    }));
  }
  function applySnapshot(snap) {
    if (!Array.isArray(snap)) return;
    for (let i = 0; i < pieces.length; i++) {
      const s = snap[i];
      if (!s) continue;
      pieces[i].cells = s.cells.map(c => [c[0], c[1]]);
      pieces[i].h = s.h; pieces[i].w = s.w;
      pieces[i].placed = !!s.placed;
      pieces[i].row = s.row || 0; pieces[i].col = s.col || 0;
    }
  }
  function pushUndoSnapshot(snap) {
    undoStack.push(snap);
    if (undoStack.length > MAX_UNDO) undoStack.shift();
    redoStack = [];
    updateUndoButton(); updateRedoButton();
  }
  function popUndo() {
    if (!undoStack.length) return false;
    const cur = snapshotPieces();
    const snap = undoStack.pop();
    redoStack.push(cur);
    if (redoStack.length > MAX_UNDO) redoStack.shift();
    applySnapshot(snap);
    renderAll(); checkWin();
    updateUndoButton(); updateRedoButton();
    scheduleSaveProgress();
    return true;
  }
  function popRedo() {
    if (!redoStack.length) return false;
    const cur = snapshotPieces();
    const snap = redoStack.pop();
    undoStack.push(cur);
    if (undoStack.length > MAX_UNDO) undoStack.shift();
    applySnapshot(snap);
    renderAll(); checkWin();
    updateUndoButton(); updateRedoButton();
    scheduleSaveProgress();
    return true;
  }
  function updateUndoButton() { btnUndo.disabled = (undoStack.length === 0) || answerMode; }
  function updateRedoButton() { btnRedo.disabled = (redoStack.length === 0) || answerMode; }

  function cancelPendingTap() {
    if (tapTimer) { clearTimeout(tapTimer); tapTimer = null; }
    pendingRotatePiece = null;
  }
  function applyPieceTransform(piece, type) {
    const snap = snapshotPieces();
    if (type === 'rotate') piece.cells = rotate90(piece.cells);
    else if (type === 'rotateCCW') piece.cells = rotateCCW(piece.cells);
    else if (type === 'mirror') piece.cells = mirror(piece.cells);
    const s = shapeSize(piece.cells);
    piece.h = s.h; piece.w = s.w;
    if (piece.placed) {
      piece.col = Math.max(0, Math.min(N - piece.w, piece.col));
      piece.row = Math.max(0, Math.min(N - piece.h, piece.row));
      renderPiecesLayer(); updateBoardView(); updateProgressText(); checkWin();
    } else {
      renderPool(); updateProgressText();
    }
    pushUndoSnapshot(snap);
    scheduleSaveProgress();
  }
  function flushPendingTap() {
    if (tapTimer) { clearTimeout(tapTimer); tapTimer = null; }
    const p = pendingRotatePiece;
    pendingRotatePiece = null;
    if (p) applyPieceTransform(p, 'rotate');
  }
  function handlePieceClick(piece, button) {
    if (button === 2) {
      cancelPendingTap();
      applyPieceTransform(piece, 'rotateCCW');
      return;
    }
    if (pendingRotatePiece === piece) {
      cancelPendingTap();
      applyPieceTransform(piece, 'mirror');
      return;
    }
    if (pendingRotatePiece) flushPendingTap();
    pendingRotatePiece = piece;
    if (tapTimer) clearTimeout(tapTimer);
    tapTimer = setTimeout(() => {
      tapTimer = null;
      const p = pendingRotatePiece;
      pendingRotatePiece = null;
      if (p) applyPieceTransform(p, 'rotate');
    }, TAP_DELAY);
  }
  function abortDrag() {
    if (!drag) return;
    const { piece, ghost, wasPlaced, prevRow, prevCol } = drag;
    ghost.remove();
    document.body.style.cursor = '';
    piece.placed = wasPlaced;
    piece.row = prevRow; piece.col = prevCol;
    drag = null;
  }

  function generateChallenge(seed, skipSave, isRandom) {
    cancelPendingTap();
    resetAnswerTapState();
    activePointerIds.clear();
    undoStack = []; redoStack = [];
    updateUndoButton(); updateRedoButton();

    const rng = mulberry32(seed);
    const list = [], placements = [];
    for (let i = 0; i < PIECE_COUNT; i++) {
      const baseCells = randomShape(rng);
      const s0 = shapeSize(baseCells);
      const rot = Math.floor(rng() * 4);
      const flip = rng() < 0.5;
      const targetCells = applyTransform(baseCells, rot, flip);
      const st = shapeSize(targetCells);
      const row = Math.floor(rng() * (N - st.h + 1));
      const col = Math.floor(rng() * (N - st.w + 1));
      const digit = Math.floor(rng() * 10);
      list.push({
        id: i,
        baseCells: baseCells.map(c => [...c]),
        cells: baseCells.map(c => [...c]),
        h: s0.h, w: s0.w,
        placed: false, row: 0, col: 0,
        digit: digit
      });
      placements.push({ cells: targetCells, row, col, rot, flip });
    }
    answerPlacements = placements;
    targetGrid = Array.from({ length: N }, () => new Array(N).fill(0));
    for (const p of placements) {
      for (const [r, c] of p.cells) {
        const rr = p.row + r, cc = p.col + c;
        if (rr >= 0 && rr < N && cc >= 0 && cc < N) targetGrid[rr][cc] ^= 1;
      }
    }
    pieces = list;
    currentSeed = seed;
    isRandomChallenge = !!isRandom;
    if (gameMode === 'challenge') {
      abandoned = false;
      digitalMode = (challengeSubMode === 'num');
    }
    solved = false;
    solvedElapsed = null;
    showingTarget = false;
    answerMode = false;
    answerIndex = 0;
    messageEl.classList.remove('show');

    if (gameMode === 'practice') {
      seedShow.textContent = seed;
    } else {
      seedShow.textContent = '？？？';
    }

    renderAll();
    updateUploadButton();
    if (!skipSave) { startTimer(); scheduleSaveProgress(); }
  }

  function buildBoard() {
    boardEl.innerHTML = '';
    boardEl.style.width = (N * BOARD_CELL) + 'px';
    boardEl.style.height = (N * BOARD_CELL) + 'px';
    cellEls = [];
    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        const d = document.createElement('div');
        d.className = 'cell white';
        d.style.left = (c * BOARD_CELL) + 'px';
        d.style.top = (r * BOARD_CELL) + 'px';
        d.style.width = BOARD_CELL + 'px';
        d.style.height = BOARD_CELL + 'px';
        boardEl.appendChild(d);
        cellEls.push(d);
      }
    }
    piecesLayer = document.createElement('div');
    piecesLayer.id = 'piecesLayer';
    boardEl.appendChild(piecesLayer);
    numbersLayer = document.createElement('div');
    numbersLayer.id = 'numbersLayer';
    boardEl.appendChild(numbersLayer);
  }

  function renderAll() {
    renderPool(); renderPiecesLayer(); updateBoardView();
    updateProgressText(); updateButtonStates(); updateModeUI();
  }

  function updateModeUI() {
    boardEl.classList.toggle('answer-mode', answerMode);
    poolEl.classList.toggle('dim', showingTarget && !answerMode);
    poolHead.textContent = answerMode ? '备选碎片池（答案标注）' : '备选碎片池';
    btnAnswer.classList.toggle('active', answerMode);

    if (gameMode === 'challenge') {
      modeBadge.classList.add('challenge-badge');
      modeBadgeText.textContent = '挑战模式 · ' + (challengeSubMode === 'num' ? '有数字' : '无数字');
    } else {
      modeBadge.classList.remove('challenge-badge');
      const sub = (gameTypeKey === 'practice-specify' ? '指定编号' : '随机选择');
      modeBadgeText.textContent = '练习模式 · ' + sub;
    }

    btnMainActionText.textContent = '新游戏';

    btnLeaderboard.style.display = (gameMode === 'challenge') ? 'inline-flex' : 'none';
    digitRow.style.display = (gameMode === 'practice') ? 'flex' : 'none';

    digitSwitch.setAttribute('aria-pressed', String(digitalMode));
    modeHint.textContent = digitalMode ? '数字已开启' : '无数字';

    colorSwitch.setAttribute('aria-pressed', String(colorMode));
    colorHint.textContent = colorMode ? '彩色' : '黑白';

    targetSwitch.setAttribute('aria-pressed', String(showingTarget));
    targetHint.textContent = showingTarget ? '已显示目标图案' : '打开来查看目标图案';
    targetSwitch.disabled = answerMode;

    numberProgressRow.style.display = digitalMode ? 'flex' : 'none';

    updateUndoButton(); updateRedoButton(); updateUploadButton();
    btnAnswer.disabled = !targetGrid;
  }

  function updateButtonStates() {
    btnReset.disabled = answerMode;
    btnAnswer.disabled = !targetGrid;
  }

  function updateBoardView() {
    let grid, matchGrid;
    if (answerMode) { grid = computeAnswerGrid(answerIndex); matchGrid = grid; }
    else {
      const actual = computeGrid(pieces);
      grid = (showingTarget && targetGrid) ? targetGrid : actual;
      matchGrid = actual;
    }
    const isPlayerMode = !showingTarget && !answerMode;
    const useColorInAnswer = answerMode && colorMode;
    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        const el = cellEls[r * N + c];
        if (!el) continue;
        const black = !!grid[r][c];
        let bg;
        if (useColorInAnswer) {
          const covering = [];
          for (let i = 0; i < answerIndex; i++) {
            const ap = answerPlacements[i];
            let hit = false;
            for (const [ar, ac] of ap.cells) {
              if (ap.row + ar === r && ap.col + ac === c) { hit = true; break; }
            }
            if (hit) covering.push(i);
          }
          if (covering.length === 0) bg = WHITE_FILL;
          else if (covering.length === 1) bg = getPieceColor(covering[0]);
          else {
            const n = covering.length;
            const stops = covering.map((idx, i) => {
              const start = (i / n * 360).toFixed(2);
              const end = ((i + 1) / n * 360).toFixed(2);
              return getPieceColor(idx) + ' ' + start + 'deg ' + end + 'deg';
            });
            bg = 'conic-gradient(' + stops.join(', ') + ')';
          }
        } else if (!isPlayerMode) {
          bg = black ? BLACK_FILL : WHITE_FILL;
        } else {
          const covering = [];
          for (const p of pieces) {
            if (!p.placed) continue;
            for (const [pr, pc] of p.cells) {
              if (p.row + pr === r && p.col + pc === c) { covering.push(p); break; }
            }
          }
          if (covering.length === 0) bg = WHITE_FILL;
          else if (colorMode) {
            covering.sort((a, b) => a.id - b.id);
            const colors = covering.map(p => getPieceColor(p.id));
            if (colors.length === 1) bg = colors[0];
            else {
              const n = colors.length;
              const stops = colors.map((color, i) => {
                const start = (i / n * 360).toFixed(2);
                const end = ((i + 1) / n * 360).toFixed(2);
                return color + ' ' + start + 'deg ' + end + 'deg';
              });
              bg = 'conic-gradient(' + stops.join(', ') + ')';
            }
          } else {
            bg = black ? BLACK_FILL : WHITE_FILL;
          }
        }
        el.style.background = bg;
        el.classList.toggle('black', black);
        el.classList.toggle('white', !black);
      }
    }
    updateMatchBars(matchGrid);
    updateNumbersLayer();
  }

  function updateNumbersLayer() {
    if (!numbersLayer) return;
    if (!digitalMode) { numbersLayer.innerHTML = ''; return; }
    let grid;
    if (answerMode) grid = computeNumberGridAnswer(answerIndex);
    else if (showingTarget) grid = computeNumberGridAnswer(answerPlacements.length);
    else grid = computeNumberGridPlayer();
    const frag = document.createDocumentFragment();
    const fontSize = Math.max(9, Math.round(BOARD_CELL * 0.4)) + 'px';
    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        const val = grid[r][c];
        if (val === 0) continue;
        const d = document.createElement('div');
        d.className = 'num-cell';
        d.textContent = val;
        d.style.left = (c * BOARD_CELL) + 'px';
        d.style.top = (r * BOARD_CELL) + 'px';
        d.style.width = BOARD_CELL + 'px';
        d.style.height = BOARD_CELL + 'px';
        d.style.fontSize = fontSize;
        const cellEl = cellEls[r * N + c];
        const isColored = colorMode && !showingTarget && !answerMode;
        if ((cellEl && cellEl.classList.contains('black')) || isColored) {
          d.classList.add('on-black');
        } else {
          d.classList.add('on-white');
        }
        frag.appendChild(d);
      }
    }
    numbersLayer.innerHTML = '';
    numbersLayer.appendChild(frag);
  }

  function updateMatchBars(blackGrid) {
    let matched = 0;
    if (targetGrid && blackGrid) {
      for (let r = 0; r < N; r++) {
        for (let c = 0; c < N; c++) {
          if (blackGrid[r][c] === targetGrid[r][c]) matched++;
        }
      }
    }
    const pct = targetGrid ? Math.round(matched / (N * N) * 100) : 0;
    progressFill.style.width = pct + '%';
    progressLabel.textContent = pct + '%';
    const full = (pct === 100);
    progressFill.classList.toggle('full', full);
    progressLabel.classList.toggle('full', full);
    if (digitalMode) {
      let numGrid;
      if (answerMode) numGrid = computeNumberGridAnswer(answerIndex);
      else numGrid = computeNumberGridPlayer();
      const targetNum = computeNumberGridAnswer(answerPlacements.length);
      let numMatched = 0;
      if (targetGrid) {
        for (let r = 0; r < N; r++) {
          for (let c = 0; c < N; c++) {
            if (numGrid[r][c] === targetNum[r][c]) numMatched++;
          }
        }
      }
      const numPct = targetGrid ? Math.round(numMatched / (N * N) * 100) : 0;
      numberProgressFill.style.width = numPct + '%';
      numberProgressLabel.textContent = numPct + '%';
      const numFull = (numPct === 100);
      numberProgressFill.classList.toggle('full', numFull);
      numberProgressLabel.classList.toggle('full', numFull);
    }
  }

  function updateProgressText() {
    if (answerMode) progressEl.textContent = '答案演示 ' + answerIndex + ' / ' + PIECE_COUNT;
    else {
      const n = pieces.filter(p => p.placed).length;
      progressEl.textContent = '已放置 ' + n + ' / ' + PIECE_COUNT;
    }
  }

  function renderPool() {
    poolEl.innerHTML = '';
    for (const p of pieces) {
      if (!answerMode && p.placed) continue;
      const item = document.createElement('div');
      item.className = 'pool-item';
      if (answerMode && p.id < answerIndex) item.classList.add('ans-done');
      const slot = document.createElement('div');
      slot.className = 'pool-slot';
      const cells = answerMode ? p.baseCells : p.cells;
      const sw = Math.max(...cells.map(c => c[1])) + 1;
      const sh = Math.max(...cells.map(c => c[0])) + 1;
      const pw = sw * POOL_CELL, ph = sh * POOL_CELL;
      const ox = (POOL_SLOT - pw) / 2, oy = (POOL_SLOT - ph) / 2;
      const el = document.createElement('div');
      el.className = 'pool-piece';
      el.style.width = POOL_SLOT + 'px';
      el.style.height = POOL_SLOT + 'px';
      el.dataset.ox = ox; el.dataset.oy = oy;
      const pieceColor = colorMode ? getPieceColor(p.id) : BLACK_FILL;
      for (const [r, c] of cells) {
        const d = document.createElement('div');
        d.className = 'pcell';
        d.style.background = pieceColor;
        d.style.left = (ox + c * POOL_CELL) + 'px';
        d.style.top = (oy + r * POOL_CELL) + 'px';
        d.style.width = POOL_CELL + 'px';
        d.style.height = POOL_CELL + 'px';
        el.appendChild(d);
      }
      if (digitalMode) {
        const numEl = document.createElement('div');
        numEl.className = 'pool-digit';
        numEl.textContent = p.digit;
        numEl.style.left = (ox + pw / 2) + 'px';
        numEl.style.top = (oy + ph / 2) + 'px';
        el.appendChild(numEl);
      }
      if (!answerMode) {
        el.addEventListener('pointerdown', ev => onPiecePointerDown(ev, p, el, 'pool'));
      }
      slot.appendChild(el);
      item.appendChild(slot);
      if (answerMode) {
        const ap = answerPlacements[p.id];
        const tag = document.createElement('div');
        tag.className = 'pool-tag';
        if (ap) tag.textContent = '旋转' + ap.rot + '次·' + (ap.flip ? '有镜像' : '无镜像');
        else tag.textContent = '—';
        item.appendChild(tag);
      }
      poolEl.appendChild(item);
    }
  }

  function renderPiecesLayer() {
    if (!piecesLayer) return;
    piecesLayer.innerHTML = '';
    if (answerMode) {
      for (let i = 0; i < answerIndex; i++) {
        const ap = answerPlacements[i];
        const w = (Math.max(...ap.cells.map(c => c[1])) + 1) * BOARD_CELL;
        const h = (Math.max(...ap.cells.map(c => c[0])) + 1) * BOARD_CELL;
        const el = document.createElement('div');
        el.className = 'answer-piece';
        el.style.left = (ap.col * BOARD_CELL) + 'px';
        el.style.top = (ap.row * BOARD_CELL) + 'px';
        el.style.width = w + 'px';
        el.style.height = h + 'px';
        const pieceColor = getPieceColor(i);
        const isLatest = (i === answerIndex - 1);
        const useColor = colorMode;
        for (const [r, c] of ap.cells) {
          const d = document.createElement('div');
          d.className = 'answer-cell';
          if (isLatest) d.classList.add('latest');
          if (useColor) {
            d.style.background = 'transparent';
            d.style.borderColor = pieceColor;
          }
          d.style.left = (c * BOARD_CELL) + 'px';
          d.style.top = (r * BOARD_CELL) + 'px';
          d.style.width = BOARD_CELL + 'px';
          d.style.height = BOARD_CELL + 'px';
          el.appendChild(d);
        }
        piecesLayer.appendChild(el);
      }
      return;
    }
    if (showingTarget) return;
    for (const p of pieces) {
      if (!p.placed) continue;
      const el = document.createElement('div');
      el.className = 'board-piece';
      el.style.left = (p.col * BOARD_CELL) + 'px';
      el.style.top = (p.row * BOARD_CELL) + 'px';
      el.style.width = (p.w * BOARD_CELL) + 'px';
      el.style.height = (p.h * BOARD_CELL) + 'px';
      for (const [r, c] of p.cells) {
        const d = document.createElement('div');
        d.className = 'bcell';
        d.style.left = (c * BOARD_CELL) + 'px';
        d.style.top = (r * BOARD_CELL) + 'px';
        d.style.width = BOARD_CELL + 'px';
        d.style.height = BOARD_CELL + 'px';
        el.appendChild(d);
      }
      el.addEventListener('pointerdown', ev => onPiecePointerDown(ev, p, el, 'board'));
      piecesLayer.appendChild(el);
    }
  }

  function onPiecePointerDown(ev, piece, el, source) {
    if (showingTarget || answerMode || !targetGrid) return;
    if (ev.button !== 0 && ev.button !== 2) return;
    ev.preventDefault();
    if (ev.button === 2) {
      cancelPendingTap(); abortDrag(); pending = null;
      applyPieceTransform(piece, 'rotateCCW');
      return;
    }
    if (activePointerIds.size > 0) {
      cancelPendingTap(); abortDrag(); pending = null;
      applyPieceTransform(piece, 'rotateCCW');
      return;
    }
    activePointerIds.add(ev.pointerId);
    pending = { piece, el, source, startX: ev.clientX, startY: ev.clientY, button: ev.button, moved: false, pointerId: ev.pointerId };
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);
    window.addEventListener('pointercancel', onPointerUp);
  }
  function onPointerMove(e) {
    if (drag) { e.preventDefault(); moveGhost(e.clientX, e.clientY); return; }
    if (!pending) return;
    if (e.pointerId !== pending.pointerId) return;
    const dx = e.clientX - pending.startX;
    const dy = e.clientY - pending.startY;
    const threshold = pending.source === 'pool' ? 100 : 49;
    if (!pending.moved && dx * dx + dy * dy > threshold) {
      pending.moved = true;
      beginDrag(e, pending.piece, pending.el, pending.source);
    }
  }
  function beginDrag(ev, piece, el, source) {
    if (drag) return;
    flushPendingTap();
    const dragSnapshot = snapshotPieces();
    const rect = el.getBoundingClientRect();
    let fx, fy;
    if (source === 'pool') {
      const ox = parseFloat(el.dataset.ox) || 0;
      const oy = parseFloat(el.dataset.oy) || 0;
      const pw = piece.w * POOL_CELL, ph = piece.h * POOL_CELL;
      const lx = ev.clientX - rect.left, ly = ev.clientY - rect.top;
      fx = pw > 0 ? (lx - ox) / pw : 0.5;
      fy = ph > 0 ? (ly - oy) / ph : 0.5;
      fx = Math.max(0, Math.min(1, fx));
      fy = Math.max(0, Math.min(1, fy));
    } else {
      fx = rect.width ? (ev.clientX - rect.left) / rect.width : 0.5;
      fy = rect.height ? (ev.clientY - rect.top) / rect.height : 0.5;
    }
    const w = piece.w * BOARD_CELL, h = piece.h * BOARD_CELL;
    const ghost = document.createElement('div');
    ghost.className = 'ghost';
    ghost.style.width = w + 'px';
    ghost.style.height = h + 'px';
    for (const [r, c] of piece.cells) {
      const d = document.createElement('div');
      d.className = 'bcell';
      d.style.left = (c * BOARD_CELL) + 'px';
      d.style.top = (r * BOARD_CELL) + 'px';
      d.style.width = BOARD_CELL + 'px';
      d.style.height = BOARD_CELL + 'px';
      ghost.appendChild(d);
    }
    document.body.appendChild(ghost);
    const wasPlaced = piece.placed;
    const prevRow = piece.row, prevCol = piece.col;
    if (piece.placed) piece.placed = false;
    drag = { piece, ghost, fx, fy, w, h, wasPlaced, prevRow, prevCol, source, dragSnapshot };
    renderPiecesLayer(); updateBoardView(); updateProgressText(); renderPool();
    moveGhost(ev.clientX, ev.clientY);
    document.body.style.cursor = 'grabbing';
  }
  function moveGhost(cx, cy) {
    if (!drag) return;
    drag.ghost.style.left = (cx - drag.fx * drag.w) + 'px';
    drag.ghost.style.top = (cy - drag.fy * drag.h) + 'px';
  }
  function onPointerUp(e) {
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('pointercancel', onPointerUp);
    activePointerIds.delete(e.pointerId);
    if (drag) {
      const { piece, ghost, fx, fy, w, h, wasPlaced, prevRow, prevCol, dragSnapshot } = drag;
      ghost.remove();
      document.body.style.cursor = '';
      const gl = e.clientX - fx * w, gt = e.clientY - fy * h;
      const bRect = boardEl.getBoundingClientRect();
      const pRect = poolEl.getBoundingClientRect();
      const cx = e.clientX, cy = e.clientY;
      const centerX = gl + w / 2, centerY = gt + h / 2;
      const overBoard =
        (cx >= bRect.left && cx <= bRect.right && cy >= bRect.top && cy <= bRect.bottom) ||
        (centerX >= bRect.left && centerX <= bRect.right && centerY >= bRect.top && centerY <= bRect.bottom);
      const overPool = cx >= pRect.left && cx <= pRect.right && cy >= pRect.top && cy <= pRect.bottom;
      let changed = false;
      if (overBoard) {
        let col = Math.round((gl - bRect.left) / BOARD_CELL);
        let row = Math.round((gt - bRect.top) / BOARD_CELL);
        col = Math.max(0, Math.min(N - piece.w, col));
        row = Math.max(0, Math.min(N - piece.h, row));
        if (!piece.placed || piece.row !== row || piece.col !== col) changed = true;
        piece.placed = true; piece.row = row; piece.col = col;
      } else if (overPool) {
        if (piece.placed) changed = true;
        piece.placed = false;
      } else {
        piece.placed = wasPlaced; piece.row = prevRow; piece.col = prevCol;
      }
      if (changed) pushUndoSnapshot(dragSnapshot);
      drag = null; pending = null;
      renderAll(); checkWin(); scheduleSaveProgress();
    } else if (pending) {
      if (e.pointerId !== pending.pointerId) return;
      const { piece, button, moved } = pending;
      if (!moved) handlePieceClick(piece, button);
      pending = null;
    }
  }

  function resetAnswerTapState() {
    if (answerSingleTapTimer) { clearTimeout(answerSingleTapTimer); answerSingleTapTimer = null; }
    answerLastTapTime = 0;
  }
  function onBoardPointerDown(e) {
    if (!answerMode) return;
    e.preventDefault();
    if (e.button === 2) {
      if (answerSingleTapTimer) { clearTimeout(answerSingleTapTimer); answerSingleTapTimer = null; }
      answerLastTapTime = 0;
      if (answerIndex > 0) { answerIndex--; renderAll(); }
      return;
    }
    if (e.button !== undefined && e.button !== 0) return;
    const now = Date.now();
    if (now - answerLastTapTime < ANSWER_DOUBLE_TAP_MS) {
      answerLastTapTime = 0;
      if (answerSingleTapTimer) { clearTimeout(answerSingleTapTimer); answerSingleTapTimer = null; }
      if (answerIndex > 0) { answerIndex--; renderAll(); }
      return;
    }
    answerLastTapTime = now;
    if (answerSingleTapTimer) clearTimeout(answerSingleTapTimer);
    answerSingleTapTimer = setTimeout(() => {
      answerSingleTapTimer = null;
      if (answerIndex < answerPlacements.length) { answerIndex++; renderAll(); }
    }, ANSWER_DOUBLE_TAP_MS);
  }

  async function toggleAnswerMode() {
    if (!targetGrid) return;

    if (gameMode === 'challenge' && !solved && !abandoned) {
      const modeText = digitalMode ? '有数字' : '无数字';
      const ok = confirm(
        '当前挑战尚未完成。\n\n' +
        '查看答案会导致本局成绩作废，并打断你在「' + modeText + '」模式下的连续成绩记录。\n\n' +
        '确定要查看答案吗？'
      );
      if (!ok) return;
      abandoned = true;
      stopTimer();
      await clearStreakOnServer(digitalMode ? 'num' : 'bw');
      resetStreakOnNextSolve = true;
      scheduleSaveProgress();
      updateUploadButton();
      showToast('本局成绩已作废，连续记录已重置', 2500);
    }

    cancelPendingTap(); abortDrag(); activePointerIds.clear(); resetAnswerTapState();
    answerMode = !answerMode;
    if (answerMode) { answerIndex = 0; showingTarget = false; }
    renderAll();
  }

  function resetBoard() {
    if (drag || answerMode || !targetGrid) return;
    cancelPendingTap(); activePointerIds.clear(); resetAnswerTapState();
    const snap = snapshotPieces();
    for (const p of pieces) {
      p.placed = false; p.row = 0; p.col = 0;
      p.cells = p.baseCells.map(c => [...c]);
      const s = shapeSize(p.cells);
      p.h = s.h; p.w = s.w;
    }
    solved = false; solvedElapsed = null;
    messageEl.classList.remove('show');
    pushUndoSnapshot(snap);
    renderAll(); scheduleSaveProgress();
  }

  function checkWin() {
    if (!targetGrid || answerMode) return;
    if (abandoned) return;
    if (pieces.some(p => !p.placed)) {
      solved = false;
      updateUploadButton();
      updateModeUI();
      return;
    }
    const g = computeGrid(pieces);
    let ok = true;
    for (let r = 0; r < N && ok; r++) {
      for (let c = 0; c < N && ok; c++) {
        if (g[r][c] !== targetGrid[r][c]) ok = false;
      }
    }
    if (ok && digitalMode) {
      const pNum = computeNumberGridPlayer();
      const tNum = computeNumberGridAnswer(answerPlacements.length);
      for (let r = 0; r < N && ok; r++) {
        for (let c = 0; c < N && ok; c++) {
          if (pNum[r][c] !== tNum[r][c]) ok = false;
        }
      }
    }
    if (ok) {
      if (!solved) {
        solved = true;
        messageEl.classList.add('show');
        setTimeout(() => messageEl.classList.remove('show'), 2600);

        if (gameMode === 'challenge') {
          seedShow.textContent = currentSeed;
        }

        stopTimer();
        const endTime = Date.now();
        solvedElapsed = challengeStartTime
          ? Math.floor((endTime - challengeStartTime) / 1000)
          : 0;

        const mode = digitalMode ? 'num' : 'bw';

        recordSuccess(currentSeed, mode, gameTypeKey, solvedElapsed, endTime);

        if (currentUser && supabase) {
          uploadScore(currentSeed, mode, gameTypeKey, solvedElapsed, endTime);
        }

        updateUploadButton();
        updateModeUI();
        scheduleSaveProgress();
      }
    } else {
      solved = false;
      updateUploadButton();
      updateModeUI();
    }
  }

  function showInputModal(defaultValue) {
    return new Promise(resolve => {
      seedInput.value = defaultValue || '';
      inputModal.classList.add('show');
      setTimeout(() => seedInput.focus(), 120);
      function cleanup() {
        inputModal.classList.remove('show');
        seedOk.removeEventListener('click', onOk);
        seedCancel.removeEventListener('click', onCancel);
        seedInput.removeEventListener('keydown', onKey);
        inputModal.removeEventListener('click', onMask);
      }
      function onOk() { const v = seedInput.value; cleanup(); resolve(v); }
      function onCancel() { cleanup(); resolve(null); }
      function onKey(ev) {
        if (ev.key === 'Enter') { ev.preventDefault(); onOk(); }
        else if (ev.key === 'Escape') { ev.preventDefault(); onCancel(); }
      }
      function onMask(ev) { if (ev.target === inputModal) onCancel(); }
      seedOk.addEventListener('click', onOk);
      seedCancel.addEventListener('click', onCancel);
      seedInput.addEventListener('keydown', onKey);
      inputModal.addEventListener('click', onMask);
    });
  }

  async function promptSeedAndStart() {
    const input = await showInputModal('');
    if (input === null) return false;
    const n = Number(String(input).trim());
    if (!Number.isInteger(n) || n < 1 || n > 100000) {
      alert('编号无效，请输入 1 ~ 100000 之间的整数。');
      return false;
    }
    const entry = getSeedEntry(n);
    if (entry && entry.state) {
      const s = entry.state;
      const hasBw = !!(s.bw && s.bw.done);
      const hasNum = !!(s.num && s.num.done);
      if (hasBw || hasNum) {
        let msg;
        if (hasBw && hasNum) msg = '你已经挑战过该关卡的「有数字」和「无数字」2 种模式';
        else if (hasBw) msg = '你已经挑战过该关卡的「无数字」模式';
        else msg = '你已经挑战过该关卡的「有数字」模式';
        const ok = confirm('关卡 #' + n + '：' + msg + '。\n\n确定要再次挑战吗？');
        if (!ok) return false;
      }
    }
    generateChallenge(n, false, false);
    return true;
  }

  function buildStateTag(state) {
    if (!state) return '';
    let practice = false, challenge = false;
    let random = false, specify = false;
    const modes = [];
    if (state.bw && state.bw.done) {
      modes.push('无数字');
      if (state.bw.practice) practice = true;
      if (state.bw.challenge) challenge = true;
      if (state.bw.random) random = true;
      if (state.bw.specify) specify = true;
    }
    if (state.num && state.num.done) {
      modes.push('有数字');
      if (state.num.practice) practice = true;
      if (state.num.challenge) challenge = true;
      if (state.num.random) random = true;
      if (state.num.specify) specify = true;
    }
    const game = [];
    if (practice) game.push('练习');
    if (challenge) game.push('挑战');
    const pick = [];
    if (random) pick.push('随机');
    if (specify) pick.push('指定');
    const parts = [];
    if (game.length) parts.push(game.join('/'));
    if (modes.length) parts.push(modes.join('/'));
    if (pick.length) parts.push(pick.join('/'));
    return parts.join(' · ');
  }

  function getBestElapsedFromState(state) {
    if (!state) return null;
    let best = null;
    ['bw', 'num'].forEach(m => {
      if (state[m] && state[m].challengeBest != null) {
        if (best == null || state[m].challengeBest < best) best = state[m].challengeBest;
      }
    });
    return best;
  }

  function renderHistory() {
    const list = getCompletedSeeds();
    const allProgress = getAllProgressMap();
    const items = [];

    Object.keys(allProgress).forEach(key => {
      const p = allProgress[key];
      if (p && p.seed && !p.solved && !p.abandoned) {
        items.push({
          seed: p.seed,
          mode: p.mode,
          gameType: key,
          time: p.saved,
          ongoing: true,
          duration: null
        });
      }
    });
    items.sort((a, b) => (b.time || 0) - (a.time || 0));

    const completed = list.slice().sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0));

    if (items.length === 0 && completed.length === 0) {
      historyList.innerHTML = '<div class="history-empty">暂无记录</div>';
      return;
    }

    let html = '';

    items.forEach(it => {
      const modeText = modeLabel(it.mode);
      const isPractice = (it.gameType === 'practice-random' || it.gameType === 'practice-specify');
      const gameText = isPractice ? '练习' : '挑战';
      const typeText = (it.gameType === 'practice-specify') ? '指定' : '随机';
      const timeText = it.time ? formatDateShort(it.time) : '—';
      const seedText = isPractice ? ('#' + it.seed) : '？？？';
      html += '<div class="history-item">' +
        '<div class="history-row1"><span class="history-seed">' + seedText + '</span>' +
        '<span class="history-tag ongoing">进行中</span></div>' +
        '<div class="history-row2"><span>' + gameText + ' · ' + modeText + ' · ' + typeText + '</span>' +
        '<span>' + timeText + '</span></div>' +
      '</div>';
    });

    completed.forEach(it => {
      const state = it.state || {};
      const stateTag = buildStateTag(state);
      const timeText = it.updatedAt ? formatDateShort(it.updatedAt) : '—';
      const bestElapsed = getBestElapsedFromState(state);
      let durationHtml = '';
      if (bestElapsed != null) {
        durationHtml = '<div class="history-duration">最快挑战用时：' + formatTimer(bestElapsed) + '</div>';
      }
      html += '<div class="history-item">' +
        '<div class="history-row1"><span class="history-seed">#' + it.seed + '</span>' +
        '<span class="history-tag success">已通关</span></div>' +
        '<div class="history-state">' + stateTag + '</div>' +
        '<div class="history-row2"><span></span><span>' + timeText + '</span></div>' +
        durationHtml +
      '</div>';
    });

    historyList.innerHTML = html;
  }
