  function makeEmptyModeState() {
    return {
      done: false, doneAt: null,
      challenge: false, practice: false,
      random: false, specify: false,
      challengeBest: null, challengeBestAt: null,
      practiceBest: null, practiceBestAt: null
    };
  }

  function updateSeedState(state, mode, gameType, elapsed, endedAt) {
    if (!state) state = {};
    const m = Object.assign(makeEmptyModeState(), state[mode] || {});
    m.done = true;
    if (!m.doneAt || endedAt > m.doneAt) m.doneAt = endedAt;

    const isChallenge = gameType === 'challenge-bw' || gameType === 'challenge-num';
    const isPractice = gameType === 'practice-random' || gameType === 'practice-specify';

    if (isChallenge) {
      m.challenge = true;
      if (m.challengeBest == null || elapsed < m.challengeBest) {
        m.challengeBest = elapsed;
        m.challengeBestAt = endedAt;
      }
    }
    if (isPractice) {
      m.practice = true;
      if (m.practiceBest == null || elapsed < m.practiceBest) {
        m.practiceBest = elapsed;
        m.practiceBestAt = endedAt;
      }
    }
    if (gameType === 'practice-specify') m.specify = true;
    else m.random = true;

    state[mode] = m;
    return state;
  }

  function migrateOldSuccessList(oldList) {
    const map = new Map();
    oldList.forEach(old => {
      if (!old || old.seed == null) return;
      let entry = map.get(old.seed);
      if (!entry) {
        entry = { seed: old.seed, state: {}, updatedAt: 0 };
        map.set(old.seed, entry);
      }
      updateSeedState(entry.state, old.mode || 'bw', old.gameType || 'challenge-bw', old.elapsed || 0, old.time || Date.now());
      if ((old.time || 0) > entry.updatedAt) entry.updatedAt = old.time;
    });
    return Array.from(map.values());
  }

  function getCompletedSeeds() {
    try {
      const raw = localStorage.getItem(getStorageKey(STORAGE_SUCCESS));
      if (!raw) return [];
      const data = JSON.parse(raw);
      if (!Array.isArray(data)) return [];
      if (data.length > 0 && data[0].mode !== undefined) {
        const migrated = migrateOldSuccessList(data);
        try { localStorage.setItem(getStorageKey(STORAGE_SUCCESS), JSON.stringify(migrated)); } catch (e) {}
        return migrated;
      }
      return data;
    } catch (e) { return []; }
  }
  function saveCompletedSeeds(list) {
    try { localStorage.setItem(getStorageKey(STORAGE_SUCCESS), JSON.stringify(list)); } catch (e) {}
  }

  function recordSuccess(seed, mode, gameType, elapsed, endedAt) {
    const list = getCompletedSeeds();
    let item = list.find(x => x && x.seed === seed);
    if (!item) {
      item = { seed, state: {}, updatedAt: endedAt };
      list.push(item);
    }
    if (!item.state) item.state = {};
    updateSeedState(item.state, mode, gameType, elapsed, endedAt);
    if (!item.updatedAt || endedAt > item.updatedAt) item.updatedAt = endedAt;
    saveCompletedSeeds(list);
  }

  function getSeedEntry(seed) {
    const list = getCompletedSeeds();
    return list.find(x => x && x.seed === seed) || null;
  }

  function getAllSolvedSeeds() {
    const set = new Set();
    getCompletedSeeds().forEach(x => { if (x && x.seed != null) set.add(x.seed); });
    return set;
  }

  function getAllProgressMap() {
    try {
      const raw = localStorage.getItem(getStorageKey(STORAGE_PROGRESS));
      if (!raw) return {};
      const data = JSON.parse(raw);
      return (data && typeof data === 'object' && !Array.isArray(data)) ? data : {};
    } catch (e) { return {}; }
  }
  function setProgressForMode(key, data) {
    const all = getAllProgressMap();
    all[key] = data;
    try { localStorage.setItem(getStorageKey(STORAGE_PROGRESS), JSON.stringify(all)); } catch (e) {}
  }
  function getProgressForMode(key) {
