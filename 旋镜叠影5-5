  async function syncRecordsFromCloud() {
    if (!supabase || !currentUser) return;
    try {
      const { data, error } = await supabase
        .from('user_seeds')
        .select('seed, state, updated_at')
        .eq('user_id', currentUser.id)
        .order('updated_at', { ascending: false });
      if (error) throw error;
      if (!data) return;

      const localList = getCompletedSeeds();
      const map = new Map();
      localList.forEach(item => { if (item && item.seed != null) map.set(item.seed, item); });

      data.forEach(rec => {
        const recTime = new Date(rec.updated_at).getTime();
        const existing = map.get(rec.seed);
        if (!existing) {
          map.set(rec.seed, {
            seed: rec.seed,
            state: rec.state || {},
            updatedAt: recTime
          });
        } else {
          if (rec.state && typeof rec.state === 'object') {
            if (!existing.state) existing.state = {};
            Object.keys(rec.state).forEach(m => {
              existing.state[m] = Object.assign({}, existing.state[m] || {}, rec.state[m] || {});
            });
          }
          if (recTime > existing.updatedAt) existing.updatedAt = recTime;
        }
      });
      saveCompletedSeeds(Array.from(map.values()));
      renderHistory();
    } catch (e) {
      console.warn('同步云端记录失败:', e);
    }
  }

  function computeStatsFromHistory(historyList) {
    const empty = { best: null, bestSeed: null, bestEndedAt: null, mo3: null, ao5: null, ao12: null };
    if (!historyList || historyList.length === 0) return empty;
    const sorted = historyList.slice().sort((a, b) =>
      new Date(a.ended_at).getTime() - new Date(b.ended_at).getTime()
    );
    const arr = sorted
      .map(r => r.elapsed)
      .filter(v => typeof v === 'number' && isFinite(v));
    if (arr.length === 0) return empty;

    const bestVal = calcBest(arr);
    const mo3 = calcMO3(arr);
    const ao5 = calcAO5(arr);
    const ao12 = calcAO12(arr);

    let bestRec = null;
    for (const r of sorted) {
      if (bestRec == null || r.elapsed < bestRec.elapsed) bestRec = r;
    }

    return {
      best: bestVal,
      bestSeed: bestRec ? bestRec.seed : null,
      bestEndedAt: bestRec ? bestRec.ended_at : null,
      mo3, ao5, ao12
    };
  }

  async function uploadScore(seed, mode, gameType, elapsed, endedAt) {
    if (!supabase || !currentUser) return false;
    const isChallenge = (gameType === 'challenge-bw' || gameType === 'challenge-num');
    const isRandom = (gameType === 'practice-random') || isChallenge;

    try {
      const username = currentUser.username
        || (currentUser.user_metadata && currentUser.user_metadata.username)
        || currentUser.email;

      const endedIso = new Date(endedAt).toISOString();

      const { error: recErr } = await supabase.from('records').insert({
        user_id: currentUser.id,
        username: username,
        seed: seed,
        mode: mode,
        is_random: isRandom,
        is_challenge: isChallenge,
        elapsed: elapsed,
        ended_at: endedIso
      });
      if (recErr) throw recErr;

      const { data: existingSeed } = await supabase
        .from('user_seeds')
        .select('state')
        .eq('user_id', currentUser.id)
        .eq('seed', seed)
        .maybeSingle();

      const baseState = (existingSeed && existingSeed.state && typeof existingSeed.state === 'object' && !Array.isArray(existingSeed.state))
        ? JSON.parse(JSON.stringify(existingSeed.state)) : {};
      updateSeedState(baseState, mode, gameType, elapsed, endedAt);

      const { error: upsertErr } = await supabase
        .from('user_seeds')
        .upsert({
          user_id: currentUser.id,
          seed: seed,
          username: username,
          state: baseState,
          updated_at: endedIso
        }, { onConflict: 'user_id,seed' });
      if (upsertErr) throw upsertErr;

      const { data: profile } = await supabase
        .from('profiles')
        .select('total_wins, bw_wins, num_wins, streak_bw, streak_num, records_bw, records_num, max_streak_bw, max_streak_num')
        .eq('id', currentUser.id)
        .maybeSingle();

      let localStreakBw = (profile && Array.isArray(profile.streak_bw)) ? profile.streak_bw.slice() : [];
      let localStreakNum = (profile && Array.isArray(profile.streak_num)) ? profile.streak_num.slice() : [];
      let bwWins = (profile && profile.bw_wins) || 0;
      let numWins = (profile && profile.num_wins) || 0;
      let recordsBw = (profile && profile.records_bw) || null;
      let recordsNum = (profile && profile.records_num) || null;
      let maxStreakBw = (profile && profile.max_streak_bw) || 0;
      let maxStreakNum = (profile && profile.max_streak_num) || 0;
      const totalWins = ((profile && profile.total_wins) || 0) + 1;

      if (isChallenge) {
        const doReset = resetStreakOnNextSolve;
        resetStreakOnNextSolve = false;

        if (mode === 'bw') {
          if (doReset) {
            localStreakBw = [elapsed];
          } else {
            localStreakBw.push(elapsed);
            if (localStreakBw.length > STREAK_MAX) localStreakBw = localStreakBw.slice(-STREAK_MAX);
          }
          bwWins += 1;
          if (localStreakBw.length > maxStreakBw) maxStreakBw = localStreakBw.length;
        } else {
          if (doReset) {
            localStreakNum = [elapsed];
          } else {
            localStreakNum.push(elapsed);
            if (localStreakNum.length > STREAK_MAX) localStreakNum = localStreakNum.slice(-STREAK_MAX);
          }
          numWins += 1;
          if (localStreakNum.length > maxStreakNum) maxStreakNum = localStreakNum.length;
        }

        const { data: history } = await supabase
          .from('records')
          .select('elapsed, seed, ended_at')
          .eq('user_id', currentUser.id)
          .eq('mode', mode)
          .eq('is_challenge', true)
          .order('ended_at', { ascending: true });

        const stats = computeStatsFromHistory(history || []);

        const oldRecords = (mode === 'bw' ? recordsBw : recordsNum) || {};
        const oldObj = (oldRecords && typeof oldRecords === 'object' && !Array.isArray(oldRecords)) ? oldRecords : {};
        const newRecords = Object.assign({}, oldObj);

        if (stats.best != null && stats.bestSeed != null) {
          const prevBest = (oldObj.best && typeof oldObj.best === 'object' && oldObj.best.elapsed != null)
            ? oldObj.best.elapsed : null;
          if (prevBest == null || stats.best < prevBest) {
            newRecords.best = {
              elapsed: stats.best,
              seed: stats.bestSeed,
              ended_at: stats.bestEndedAt
            };
          }
        }

        ['mo3', 'ao5', 'ao12'].forEach(k => {
          const v = stats[k];
          if (v == null) return;
          const prev = (typeof oldObj[k] === 'number') ? oldObj[k] : null;
          if (prev == null || v < prev) newRecords[k] = v;
        });

        if (mode === 'bw') recordsBw = newRecords;
        else recordsNum = newRecords;
      }

      const updateData = {
        total_wins: totalWins,
        bw_wins: bwWins,
        num_wins: numWins,
        streak_bw: localStreakBw,
        streak_num: localStreakNum,
        max_streak_bw: maxStreakBw,
        max_streak_num: maxStreakNum,
        records_bw: recordsBw,
        records_num: recordsNum,
        updated_at: new Date().toISOString()
      };

      if (profile) {
        await supabase.from('profiles').update(updateData).eq('id', currentUser.id);
      } else {
        await supabase.from('profiles').insert({
          id: currentUser.id,
          username: username,
          ...updateData
        });
      }

      streakBw = localStreakBw;
      streakNum = localStreakNum;

      renderHistory();
      return true;
    } catch (e) {
      console.error('上传失败:', e);
      return false;
    }
  }

