        const recordsRaw = isNum ? prof.records_num : prof.records_bw;
        const records = (recordsRaw && typeof recordsRaw === 'object' && !Array.isArray(recordsRaw)) ? recordsRaw : {};

        const storedBest = (records.best && typeof records.best === 'object' && records.best.elapsed != null)
          ? records.best : null;
        const best = storedBest ? storedBest.elapsed : calcBest(arr);
        const bestSeed = storedBest ? storedBest.seed : null;
        const bestEndedAt = storedBest ? storedBest.ended_at : null;

        const mo3 = (typeof records.mo3 === 'number') ? records.mo3 : calcMO3(arr);
        const ao5 = (typeof records.ao5 === 'number') ? records.ao5 : calcAO5(arr);
        const ao12 = (typeof records.ao12 === 'number') ? records.ao12 : calcAO12(arr);
        const amount = isNum ? (prof.num_wins || 0) : (prof.bw_wins || 0);

        if (best == null && mo3 == null && ao5 == null && ao12 == null && amount === 0) return;

        items.push({
