        scoreFn = it => formatDuration(it.best);
      } else if (tab === 'mo3') {
        sorted = items.filter(it => it.mo3 != null).sort((a, b) => a.mo3 - b.mo3);
        scoreFn = it => formatDuration(it.mo3);
      } else if (tab === 'ao5') {
        sorted = items.filter(it => it.ao5 != null).sort((a, b) => a.ao5 - b.ao5);
        scoreFn = it => formatDuration(it.ao5);
      } else if (tab === 'ao12') {
        sorted = items.filter(it => it.ao12 != null).sort((a, b) => a.ao12 - b.ao12);
        scoreFn = it => formatDuration(it.ao12);
      } else {
        sorted = items.filter(it => it.amount > 0).sort((a, b) => b.amount - a.amount);
        scoreFn = it => it.amount + ' 次';
      }

      sorted = sorted.slice(0, 100);
      if (sorted.length === 0) {
        rankList.innerHTML = '<div class="rank-empty">暂无数据</div>';
        return;
      }

      let html = '';
      sorted.forEach((item, index) => {
        html += '<div class="rank-item">' +
          '<div class="rank-main">' +
            '<span class="rank-no">' + (index + 1) + '</span>' +
            '<span class="rank-name">' + (item.username || '匿名') + '</span>' +
            '<span class="rank-score">' + scoreFn(item) + '</span>' +
          '</div>';
        if (tab === 'best' && item.bestSeed != null) {
          const t = item.bestEndedAt ? formatDateShort(new Date(item.bestEndedAt).getTime()) : '—';
          html += '<div class="rank-meta">' +
            '<span class="rank-seed">#' + item.bestSeed + '</span>' +
            '<span class="rank-time">' + t + '</span>' +
          '</div>';
        }
        html += '</div>';
      });
      rankList.innerHTML = html;
    } catch (e) {
      console.error(e);
      rankList.innerHTML = '<div class="rank-empty">加载失败</div>';
    }
  }

  async function loadMyRecords(mode) {
    if (!supabase) { myRecordsContent.innerHTML = '<div class="records-empty">服务尚未就绪</div>'; return; }
    if (!currentUser) { myRecordsContent.innerHTML = '<div class="records-empty">请先登录查看个人纪录</div>'; return; }
    myRecordsContent.innerHTML = '<div class="records-empty">加载中...</div>';
    try {
      const isNum = (mode === 'num');

      const { data: allProfiles, error } = await supabase
        .from('profiles')
        .select('id, streak_bw, streak_num, bw_wins, num_wins, records_bw, records_num, max_streak_bw, max_streak_num')
        .limit(500);
      if (error) throw error;
      if (!allProfiles) {
        myRecordsContent.innerHTML = '<div class="records-empty">暂无数据</div>';
        return;
      }

      const myProfile = allProfiles.find(p => p.id === currentUser.id);
      if (!myProfile) {
        myRecordsContent.innerHTML = '<div class="records-empty">暂无数据</div>';
        return;
      }

      const myStreakRaw = isNum ? myProfile.streak_num : myProfile.streak_bw;
      const myStreak = Array.isArray(myStreakRaw) ? myStreakRaw : [];
      const myRecordsRaw = isNum ? myProfile.records_num : myProfile.records_bw;
      const myRecords = (myRecordsRaw && typeof myRecordsRaw === 'object' && !Array.isArray(myRecordsRaw)) ? myRecordsRaw : {};

      const curBest = calcBest(myStreak);
      const curMo3 = calcMO3(myStreak);
      const curAo5 = calcAO5(myStreak);
      const curAo12 = calcAO12(myStreak);
      const curStreak = myStreak.length;
      const maxStreak = (isNum ? myProfile.max_streak_num : myProfile.max_streak_bw) || 0;

      const storedBest = (myRecords.best && typeof myRecords.best === 'object' && myRecords.best.elapsed != null)
        ? myRecords.best.elapsed : null;

      const best = {
        best: storedBest != null ? storedBest : curBest,
        mo3: (typeof myRecords.mo3 === 'number') ? myRecords.mo3 : curMo3,
        ao5: (typeof myRecords.ao5 === 'number') ? myRecords.ao5 : curAo5,
        ao12: (typeof myRecords.ao12 === 'number') ? myRecords.ao12 : curAo12,
        streak: maxStreak
      };
      const current = {
        best: curBest, mo3: curMo3, ao5: curAo5, ao12: curAo12,
        streak: curStreak
      };

      const allUsers = allProfiles.map(p => {
        const arrRaw = isNum ? p.streak_num : p.streak_bw;
        const arr = Array.isArray(arrRaw) ? arrRaw : [];
        const recRaw = isNum ? p.records_num : p.records_bw;
        const rec = (recRaw && typeof recRaw === 'object' && !Array.isArray(recRaw)) ? recRaw : {};
        const sb = (rec.best && typeof rec.best === 'object' && rec.best.elapsed != null)
          ? rec.best.elapsed : calcBest(arr);
        return {
          id: p.id,
          best: sb,
          mo3: (typeof rec.mo3 === 'number') ? rec.mo3 : calcMO3(arr),
          ao5: (typeof rec.ao5 === 'number') ? rec.ao5 : calcAO5(arr),
          ao12: (typeof rec.ao12 === 'number') ? rec.ao12 : calcAO12(arr),
          streak: (isNum ? p.max_streak_num : p.max_streak_bw) || 0
        };
      });

      const rankOf = (key, desc) => {
        const filtered = allUsers.filter(x => x[key] != null).sort((a, b) => {
          return desc ? (b[key] - a[key]) : (a[key] - b[key]);
        });
        const idx = filtered.findIndex(x => x.id === currentUser.id);
        return idx >= 0 ? idx + 1 : null;
      };

      const ranks = {
        best: rankOf('best', false),
        mo3: rankOf('mo3', false),
        ao5: rankOf('ao5', false),
        ao12: rankOf('ao12', false),
        streak: rankOf('streak', true)
      };

      renderMyRecords(current, best, ranks);
    } catch (e) {
      console.error('加载个人纪录失败:', e);
      myRecordsContent.innerHTML = '<div class="records-empty">加载失败</div>';
    }
  }

  function renderMyRecords(current, best, ranks) {
    const rows = [
      { label: 'Best',   key: 'best',   unit: 'time' },
      { label: 'MO3',    key: 'mo3',    unit: 'time' },
      { label: 'AO5',    key: 'ao5',    unit: 'time' },
      { label: 'AO12',   key: 'ao12',   unit: 'time' },
      { label: 'Streak', key: 'streak', unit: 'count' }
    ];
    const fmt = (val, unit) => {
      if (val == null) return '—';
      if (unit === 'count') return val + ' 次';
      return formatTimer(val);
    };
    let html = '<div class="records-grid">';
    html += '<div class="records-cell header label">项目</div>';
    html += '<div class="records-cell header">当前</div>';
    html += '<div class="records-cell header">最好</div>';
    html += '<div class="records-cell header">排名</div>';
    rows.forEach(row => {
      html += '<div class="records-cell label">' + row.label + '</div>';
      html += '<div class="records-cell value-current">' + fmt(current[row.key], row.unit) + '</div>';
      html += '<div class="records-cell value-best">' + fmt(best[row.key], row.unit) + '</div>';
      html += '<div class="records-cell value-rank">' + (ranks[row.key] ? ('#' + ranks[row.key]) : '—') + '</div>';
    });
    html += '</div>';
    myRecordsContent.innerHTML = html;
  }

  function startMode(action) {
    if (currentSeed && gameScreen.classList.contains('active')) {
      saveProgress();
    }

    if (action === 'practice-random') {
      gameMode = 'practice';
      challengeSubMode = 'bw';
      gameTypeKey = 'practice-random';
      digitalMode = false;
      isRandomChallenge = true;
      enterGameAndStart();
    } else if (action === 'practice-specify') {
      gameMode = 'practice';
      challengeSubMode = 'bw';
      gameTypeKey = 'practice-specify';
      digitalMode = false;
      isRandomChallenge = false;
      homeScreen.classList.add('hidden');
      gameScreen.classList.add('active');
      if (!loadProgressForCurrentMode()) {
        promptSeedAndStart().then(started => {
          if (!started) {
            gameScreen.classList.remove('active');
            homeScreen.classList.remove('hidden');
          }
        });
      } else {
        updateUndoButton(); updateRedoButton();
      }
      updateModeUI();
      return;
    } else if (action === 'challenge-bw') {
      gameMode = 'challenge';
      challengeSubMode = 'bw';
      gameTypeKey = 'challenge-bw';
      digitalMode = false;
      isRandomChallenge = true;
      enterGameAndStart();
    } else if (action === 'challenge-num') {
      gameMode = 'challenge';
      challengeSubMode = 'num';
      gameTypeKey = 'challenge-num';
      digitalMode = true;
      isRandomChallenge = true;
      enterGameAndStart();
    }
  }

  function enterGameAndStart() {
    homeScreen.classList.add('hidden');
    gameScreen.classList.add('active');
    if (!loadProgressForCurrentMode()) {
      const s = pickNewSeed();
      generateChallenge(s, false, true);
    } else {
      updateUndoButton(); updateRedoButton();
    }
    updateModeUI();
  }

  function backToHome() {
    if (currentSeed) saveProgress();
    gameScreen.classList.remove('active');
    homeScreen.classList.remove('hidden');
    stopTimer();
  }

  document.querySelectorAll('.mode-btn').forEach(btn => {
    btn.addEventListener('click', () => startMode(btn.dataset.action));
  });

  btnBack.addEventListener('click', backToHome);
  homeBtnHistory.addEventListener('click', openHistory);
  homeBtnHelp.addEventListener('click', openRules);
  btnHelp.addEventListener('click', openRules);
  rulesClose.addEventListener('click', closeRules);
  rulesModal.addEventListener('click', (e) => { if (e.target === rulesModal) closeRules(); });

  homeBtnMyRecords.addEventListener('click', () => {
    if (!currentUser) { alert('请先登录后再查看个人纪录'); return; }
    currentRecordTab = 'bw';
    myRecordTabs.forEach(t => t.classList.toggle('active', t.dataset.recordtab === 'bw'));
    myRecordsModal.classList.add('show');
    loadMyRecords('bw');
  });
  myRecordsClose.addEventListener('click', () => myRecordsModal.classList.remove('show'));
  myRecordsModal.addEventListener('click', (e) => { if (e.target === myRecordsModal) myRecordsModal.classList.remove('show'); });
  myRecordTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      myRecordTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentRecordTab = tab.dataset.recordtab;
      loadMyRecords(currentRecordTab);
    });
  });

  btnMainAction.addEventListener('click', async () => {
    if (gameMode === 'challenge') {
      if (currentSeed && !solved && !abandoned) {
        const modeText = digitalMode ? '有数字' : '无数字';
        const ok = confirm(
          '当前挑战尚未完成。\n\n' +
          '开始新游戏将放弃当前挑战，并打断你在「' + modeText + '」模式下的连续成绩记录。\n\n' +
          '确定要开始新游戏吗？'
        );
        if (!ok) return;
        await clearStreakOnServer(digitalMode ? 'num' : 'bw');
        abandoned = true;
        stopTimer();
        resetStreakOnNextSolve = true;
        scheduleSaveProgress();
      }
      generateChallenge(pickNewSeed(), false, true);
    } else {
      if (gameTypeKey === 'practice-random') {
        generateChallenge(pickNewSeed(), false, true);
      } else {
        await promptSeedAndStart();
      }
    }
  });

  btnReset.addEventListener('click', resetBoard);
  btnAnswer.addEventListener('click', toggleAnswerMode);
  btnUndo.addEventListener('click', () => { if (answerMode) return; popUndo(); });
  btnRedo.addEventListener('click', () => { if (answerMode) return; popRedo(); });

  btnUpload.addEventListener('click', async () => {
    if (gameMode !== 'challenge') { alert('练习模式不能上传成绩'); return; }
    if (!supabase) { alert('服务尚未就绪'); return; }
    if (!currentUser) { alert('请先登录账号'); return; }
    if (!solved || abandoned) { alert('本局未成功或已作废，无法上传'); return; }
    if (solvedElapsed == null) { alert('无法获取用时'); return; }
    const mode = digitalMode ? 'num' : 'bw';
    const endedAt = Date.now();
    const ok = await uploadScore(currentSeed, mode, gameTypeKey, solvedElapsed, endedAt);
    showToast(ok ? '成绩上传成功！' : '上传失败，请检查网络');
    updateUploadButton();
  });

  historyClose.addEventListener('click', closeHistory);
  historyClear.addEventListener('click', () => {
    if (!confirm('确定清空全部本地历史记录吗？（云端记录不会删除）')) return;
    try {
      localStorage.removeItem(getStorageKey(STORAGE_SUCCESS));
      localStorage.removeItem(getStorageKey(STORAGE_PROGRESS));
    } catch (e) {}
    if (currentUser) syncRecordsFromCloud();
    else renderHistory();
  });
  historyModal.addEventListener('click', (e) => { if (e.target === historyModal) closeHistory(); });

  btnLeaderboard.addEventListener('click', () => {
    if (gameMode !== 'challenge') return;
    leaderboardModal.classList.add('show');
    loadRanking(currentRankTab);
  });
  leaderboardClose.addEventListener('click', () => leaderboardModal.classList.remove('show'));
  rankTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      rankTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      currentRankTab = tab.dataset.tab;
      loadRanking(currentRankTab);
    });
  });

  boardEl.addEventListener('pointerdown', onBoardPointerDown);
  boardEl.addEventListener('contextmenu', (e) => e.preventDefault());

  digitSwitch.addEventListener('click', () => {
    if (gameMode !== 'practice') return;
    digitalMode = !digitalMode;
    updateModeUI(); renderPool(); updateBoardView();
    if (answerMode) renderPiecesLayer();
    checkWin(); scheduleSaveProgress();
  });

  colorSwitch.addEventListener('click', () => {
    colorMode = !colorMode;
    updateModeUI(); renderPool(); updateBoardView();
    if (answerMode) renderPiecesLayer();
    scheduleSaveProgress();
  });

  targetSwitch.addEventListener('click', () => {
    if (!targetGrid || answerMode) return;
    cancelPendingTap();
    showingTarget = !showingTarget;
    updateBoardView(); renderPiecesLayer(); updateModeUI();
  });

  let resizeTimer = null;
  window.addEventListener('resize', () => {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      const prev = BOARD_CELL + '|' + POOL_SLOT;
      computeSizes();
      const next = BOARD_CELL + '|' + POOL_SLOT;
      if (prev !== next) { buildBoard(); renderAll(); }
    }, 160);
  });

  function initApp() {
    computeSizes();
    buildBoard();
    renderAll();
    updateUserUI();
    updateUploadButton();
    poolEl.addEventListener('contextmenu', e => e.preventDefault());
  }

  initApp();

  waitForSupabase(50).then(() => {
    updateUserUI();
    updateUploadButton();
  });

})();
</script>
</body>
</html>
