<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>旋镜叠影</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
    background: linear-gradient(160deg, #eef2ff 0%, #f8fafc 60%, #f1f5f9 100%);
    color: #1e293b;
    min-height: 100vh;
  }
  body {
    display: flex; justify-content: center;
    padding: 16px 12px 32px;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .wrap { width: 100%; max-width: 400px; }

  #homeScreen { display: block; }
  #homeScreen.hidden { display: none; }

  .home-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 18px;
    padding: 0 2px;
  }
  .home-header h1 {
    flex: 1;
    font-size: 22px;
    letter-spacing: 6px;
    text-align: center;
    margin: 0;
    color: #1e3a8a;
    text-shadow: 0 2px 0 rgba(255,255,255,.9);
    white-space: nowrap;
  }
  .home-header-left, .home-header-right {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .home-header-left { min-width: 82px; }
  .home-header-right { min-width: 82px; justify-content: flex-end; }
  .home-icon-btn {
    width: 38px; height: 38px;
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #475569;
    cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 2px rgba(15,23,42,.05);
    transition: all .15s;
    font-family: inherit;
    flex-shrink: 0;
  }
  .home-icon-btn:hover {
    background: #f1f5f9;
    transform: translateY(-1px);
    color: #1e293b;
  }
  .home-icon-btn:active { transform: translateY(0); }

  .home-user-row {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
    padding: 8px 12px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font-size: 12px;
    color: #64748b;
    min-height: 40px;
    box-shadow: 0 1px 2px rgba(15,23,42,.04);
  }
  .home-user-row .user-label { font-weight: 600; color: #475569; }
  .home-user-row .username {
    font-weight: 700;
    color: #1e293b;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .home-user-row .link-btn {
    background: none;
    border: none;
    color: #2563eb;
    font-weight: 700;
    font-size: 12px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    font-family: inherit;
    transition: background .15s;
  }
  .home-user-row .link-btn:hover { background: #eff6ff; }

  .mode-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
  }
  .mode-btn {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 14px;
    border: 1px solid #cbd5e1;
    background: #fff;
    cursor: pointer;
    font-family: inherit;
    text-align: center;
    transition: all .18s ease;
    box-shadow: 0 2px 6px rgba(15,23,42,.05);
    width: 100%;
  }
  .mode-btn:hover {
    border-color: #93c5fd;
    background: linear-gradient(135deg, #f8fafc, #eff6ff);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37,99,235,.14);
  }
  .mode-btn:active { transform: translateY(0); }

  .mode-btn .mode-icon {
    font-size: 32px;
    line-height: 1;
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #f1f5f9;
    transition: background .18s;
  }
  .mode-btn:hover .mode-icon { background: #dbeafe; }

  .mode-btn .mode-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    flex: 0 1 auto;
    min-width: 0;
  }
  .mode-btn .mode-title {
    font-size: 14px;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: .5px;
    text-align: center;
  }
  .mode-btn .mode-desc {
    font-size: 11px;
    color: #94a3b8;
    line-height: 1.4;
    text-align: center;
  }

  .mode-btn.challenge { border-color: #fed7aa; }
  .mode-btn.challenge .mode-icon { background: #fffbeb; }
  .mode-btn.challenge:hover {
    border-color: #f59e0b;
    background: linear-gradient(135deg, #fffbeb, #fef3c7);
    box-shadow: 0 8px 20px rgba(245,158,11,.18);
  }
  .mode-btn.challenge:hover .mode-icon { background: #fde68a; }
  .mode-btn.challenge .mode-title { color: #b45309; }

  /* ========== 游戏界面 ========== */
  #gameScreen { display: none; }
  #gameScreen.active { display: block; }

  .game-header {
    display: flex; align-items: center; justify-content: space-between;
    gap: 8px; margin-bottom: 10px;
  }
  .btn-back {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 6px 10px; border-radius: 8px;
    border: 1px solid #cbd5e1; background: #fff; color: #475569;
    font-size: 12px; font-weight: 700; cursor: pointer;
    font-family: inherit; box-shadow: 0 1px 2px rgba(15,23,42,.05);
    transition: all .15s;
  }
  .btn-back:hover { background: #f1f5f9; }
  .mode-badge {
    flex: 1; text-align: center;
    font-size: 12px; font-weight: 700; letter-spacing: 1px;
    color: #1e3a8a;
    background: #eff6ff; border: 1px solid #bfdbfe;
    padding: 5px 10px; border-radius: 8px;
    display: inline-flex; align-items: center; justify-content: center;
    gap: 6px;
  }
  .mode-badge.challenge-badge {
    color: #b45309; background: #fffbeb; border-color: #fde68a;
  }

  .btn {
    padding: 8px 12px; border-radius: 9px;
    font-size: 13px; font-weight: 700;
    cursor: pointer;
    border: 1px solid #cbd5e1; background: #fff; color: #1e293b;
    transition: all .15s ease; font-family: inherit;
    box-shadow: 0 1px 2px rgba(15,23,42,.05);
    display: inline-flex; align-items: center; justify-content: center;
    gap: 5px; white-space: nowrap;
  }
  .btn:hover { background: #f1f5f9; transform: translateY(-1px); }
  .btn:active { transform: translateY(0); }
  .btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }
  .btn.icon-btn { padding: 8px 10px; }
  .btn.icon-btn svg { display: block; }

  .controls {
    display: flex; justify-content: center; align-items: stretch;
    gap: 8px; margin-bottom: 10px;
  }
  .controls .btn {
    background: #fff; color: #1e293b; font-weight: 700; font-size: 13px;
    border: 1px solid #cbd5e1;
    height: 42px; padding: 0 12px;
    box-sizing: border-box;
    box-shadow: 0 1px 2px rgba(15,23,42,.05);
    flex-shrink: 0;
  }
  .controls .btn.icon-btn { width: 42px; padding: 0; }
  .controls .btn.main-action {
    flex: 1; min-width: 0;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: #fff; border-color: #2563eb;
  }
  .controls .btn.main-action:hover {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    border-color: #1d4ed8;
  }
  .controls .btn.answer.active {
    background: #fef3c7; border-color: #f59e0b; color: #b45309;
    box-shadow: 0 0 0 2px rgba(245,158,11,.28), 0 4px 12px rgba(245,158,11,.28);
  }
  .controls .btn.answer.active svg {
    stroke: #d97706;
    filter: drop-shadow(0 0 5px rgba(245,158,11,.85));
  }
  .controls .btn:disabled { opacity: .4; }
  .controls .btn svg { width: 18px; height: 18px; display: block; flex-shrink: 0; }

  @media (max-width: 420px) {
    .controls { gap: 6px; }
    .controls .btn { font-size: 12px; padding: 0 10px; height: 40px; }
    .controls .btn.icon-btn { width: 40px; }
    .controls .btn svg { width: 16px; height: 16px; }
  }
  @media (max-width: 360px) {
    .controls .btn { font-size: 11px; padding: 0 8px; height: 38px; }
    .controls .btn.icon-btn { width: 36px; }
  }

  .user-row {
    display: flex; justify-content: flex-end; align-items: center;
    gap: 8px; margin-bottom: 6px;
    font-size: 12px; color: #64748b; min-height: 22px;
  }
  .user-row .username {
    font-weight: 700; color: #1e293b;
    max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .user-row .link-btn {
    background: none; border: none;
    color: #2563eb; font-weight: 700; font-size: 12px;
    cursor: pointer; padding: 2px 6px; border-radius: 4px;
    font-family: inherit;
  }
  .user-row .link-btn:hover { background: #eff6ff; }

  .board-tools {
    display: flex; justify-content: center; gap: 12px;
    margin: 4px 0 8px;
  }
  .board-tools .btn { padding: 8px 12px; }

  .meta {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 12px; color: #64748b; margin-bottom: 8px; padding: 0 2px;
  }
  .meta b { color: #2563eb; font-size: 13px; }

  .timer-row {
    display: flex; justify-content: center; align-items: center;
    margin: 0 0 8px; font-size: 14px; font-weight: 700;
    color: #2563eb; letter-spacing: 0.5px;
  }
  .timer-row span {
    background: #eff6ff; padding: 3px 14px; border-radius: 20px;
    border: 1px solid #bfdbfe; font-variant-numeric: tabular-nums;
  }

  .mode-row {
    display: flex; align-items: center; justify-content: space-between;
    margin: 0 0 8px; padding: 0 2px;
    font-size: 12px; color: #64748b;
  }
  .mode-label {
    font-weight: 600; letter-spacing: 1px;
    display: flex; align-items: center; gap: 6px;
    flex: 1; min-width: 0;
  }
  .mode-label .hint { font-size: 10px; font-weight: 500; color: #94a3b8; }
  .switch {
    position: relative;
    width: 50px; height: 28px;
    border-radius: 14px; background: #cbd5e1;
    border: none; cursor: pointer; padding: 0;
    transition: background .22s ease;
    box-shadow: inset 0 1px 3px rgba(15,23,42,.15);
    outline: none; -webkit-tap-highlight-color: transparent; flex-shrink: 0;
  }
  .switch[aria-pressed="true"] { background: linear-gradient(135deg, #3b82f6, #2563eb); }
  .switch:disabled { opacity: .4; cursor: not-allowed; }
  .switch-knob {
    position: absolute; top: 3px; left: 3px;
    width: 22px; height: 22px; border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 4px rgba(15,23,42,.25), 0 0 0 1px rgba(15,23,42,.05);
    transition: left .22s cubic-bezier(.4,0,.2,1);
  }
  .switch[aria-pressed="true"] .switch-knob { left: 25px; }

  .progress-row {
    display: flex; align-items: center; gap: 8px;
    margin: 0 0 8px; padding: 0 2px;
  }
  .progress-name {
    font-size: 12px; font-weight: 600; color: #64748b;
    letter-spacing: 1px; width: 78px; flex-shrink: 0; text-align: left;
  }
  .progress-track {
    flex: 1; height: 10px; border-radius: 999px;
    background: #e2e8f0; overflow: hidden;
    box-shadow: inset 0 1px 2px rgba(15,23,42,.10);
  }
  .progress-fill {
    height: 100%; width: 0%; border-radius: 999px;
    background: linear-gradient(90deg, #60a5fa, #2563eb);
    transition: width .22s ease, background .22s ease;
  }
  .progress-fill.full { background: linear-gradient(90deg, #34d399, #16a34a); }
  .progress-fill.number-fill { background: linear-gradient(90deg, #a78bfa, #7c3aed); }
  .progress-fill.number-fill.full { background: linear-gradient(90deg, #34d399, #16a34a); }
  .progress-label {
    font-size: 12px; font-weight: 700; color: #2563eb;
    min-width: 40px; text-align: right;
    font-variant-numeric: tabular-nums; letter-spacing: .5px;
  }
  .progress-label.full { color: #16a34a; }
  .progress-label.number-label { color: #7c3aed; }
  .progress-label.number-label.full { color: #16a34a; }

  #board {
    position: relative; margin: 0 auto 16px;
    background: #fff; border-radius: 8px;
    box-shadow: 0 0 0 2px #94a3b8, 0 10px 26px rgba(15,23,42,.10);
    touch-action: none; overflow: hidden;
  }
  #board.answer-mode {
    box-shadow: 0 0 0 2px #f59e0b, 0 10px 26px rgba(245,158,11,.25);
    cursor: pointer;
  }
  .cell {
    position: absolute; border: 1px solid #e2e8f0;
    transition: background-color .12s linear;
  }
  .cell.white { background: #ffffff; }
  .cell.black { background: #1e293b; }

  #piecesLayer { position: absolute; inset: 0; pointer-events: none; }
  .board-piece { position: absolute; pointer-events: auto; cursor: pointer; touch-action: none; }
  .board-piece:active { cursor: grabbing; }
  .bcell {
    position: absolute; pointer-events: none;
    border: 2px solid rgba(37,99,235,.85);
    border-radius: 5px; background: transparent;
    transition: background-color .12s;
  }
  .board-piece:hover .bcell { background: rgba(37,99,235,.25); }

  #numbersLayer { position: absolute; inset: 0; pointer-events: none; z-index: 20; }
  .num-cell {
    position: absolute;
    display: flex; align-items: center; justify-content: center;
    font-weight: 800; font-family: inherit; pointer-events: none;
    line-height: 1; letter-spacing: 0;
  }
  .num-cell.on-white {
    color: #0f172a;
    text-shadow: -1px -1px 0 rgba(255,255,255,.95), 1px -1px 0 rgba(255,255,255,.95), -1px 1px 0 rgba(255,255,255,.95), 1px 1px 0 rgba(255,255,255,.95), 0 0 5px rgba(255,255,255,.9);
  }
  .num-cell.on-black {
    color: #f8fafc;
    text-shadow: -1px -1px 0 rgba(0,0,0,.9), 1px -1px 0 rgba(0,0,0,.9), -1px 1px 0 rgba(0,0,0,.9), 1px 1px 0 rgba(0,0,0,.9), 0 0 5px rgba(0,0,0,.8);
  }

  .answer-piece { position: absolute; pointer-events: none; }
  .answer-cell {
    position: absolute; border: 2px solid rgba(245, 158, 11, 0.75);
    border-radius: 4px; box-sizing: border-box; pointer-events: none;
    transition: background-color .15s, border-color .15s;
  }
  .answer-cell.latest {
    border: 3px solid #dc2626;
    box-shadow: 0 0 8px rgba(220, 38, 38, 0.6);
    z-index: 5;
  }

  .pool-head { font-size: 12px; color: #64748b; margin: 0 0 6px 2px; letter-spacing: 1px; }
  .pool {
    display: grid; justify-content: space-between; row-gap: 12px;
    padding: 10px; background: #f8fafc; border: 1px dashed #cbd5e1;
    border-radius: 12px; min-height: 98px; transition: opacity .2s;
  }
  .pool.dim { opacity: .4; }
  .pool:empty::after {
    content: '碎片已全部用尽'; margin: auto; font-size: 13px;
    color: #94a3b8; grid-column: 1 / -1;
  }
  .pool-item {
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    transition: opacity .2s; width: var(--pool-slot, 78px);
  }
  .pool-item.ans-done { opacity: .3; }
  .pool-slot {
    width: var(--pool-slot, 78px); height: var(--pool-slot, 78px);
    border-radius: 9px; background: #fff; border: 1px solid #e2e8f0;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 1px 3px rgba(15,23,42,.05); position: relative;
  }
  .pool-piece {
    position: relative; cursor: pointer; touch-action: none;
    width: var(--pool-slot, 78px); height: var(--pool-slot, 78px);
  }
  .pool-piece:active { cursor: grabbing; }
  .pcell {
    position: absolute; border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.4); pointer-events: none;
  }
  .pool-digit {
    position: absolute; transform: translate(-50%, -50%);
    font-size: 15px; font-weight: 800; color: #fff; background: #dc2626;
    min-width: 22px; height: 22px; line-height: 22px; text-align: center;
    padding: 0 4px; border-radius: 11px; border: 2px solid #fff;
    box-shadow: 0 2px 5px rgba(220,38,38,.45); pointer-events: none;
    z-index: 3; font-family: inherit;
  }
  .pool-tag {
    font-size: 9px; font-weight: 700; line-height: 1.3;
    color: #6d28d9; background: #f3e8ff;
    padding: 1px 4px; border-radius: 5px;
    width: 100%; text-align: center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  .ghost {
    position: fixed; pointer-events: none; z-index: 9999;
    opacity: .88; filter: drop-shadow(0 8px 14px rgba(15,23,42,.35));
  }

  .message {
    position: fixed; left: 50%; top: 38%;
    transform: translate(-50%, -50%) scale(.75);
    background: linear-gradient(135deg, #16a34a, #22c55e);
    color: #fff; padding: 20px 34px; border-radius: 16px;
    font-size: 19px; font-weight: 700; letter-spacing: 2px;
    opacity: 0; pointer-events: none; transition: all .32s cubic-bezier(.2,.9,.3,1.4);
    z-index: 10000; box-shadow: 0 16px 40px rgba(22,163,74,.4);
  }
  .message.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }

  .toast {
    position: fixed; left: 50%; bottom: 40px;
    transform: translateX(-50%) translateY(20px);
    background: rgba(15,23,42,.9); color: #fff;
    padding: 10px 20px; border-radius: 10px;
    font-size: 13px; font-weight: 600;
    opacity: 0; pointer-events: none;
    transition: all .25s; z-index: 10002;
    box-shadow: 0 8px 24px rgba(15,23,42,.3);
    max-width: 90vw; text-align: center;
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  .modal-mask {
    position: fixed; inset: 0;
    background: rgba(15,23,42,.45);
    display: none; align-items: center; justify-content: center;
    z-index: 10001; padding: 20px;
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
  }
  .modal-mask.show { display: flex; }
  .modal-box {
    background: #fff; border-radius: 14px; padding: 18px;
    width: 100%; max-width: 360px;
    box-shadow: 0 20px 50px rgba(15,23,42,.3);
    animation: modalIn .22s cubic-bezier(.2,.9,.3,1.3);
  }
  @keyframes modalIn {
    from { transform: scale(.88); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
  .modal-title {
    font-size: 15px; font-weight: 700;
    margin-bottom: 12px; color: #1e3a8a; letter-spacing: 1px;
  }
  .modal-input {
    width: 100%; padding: 10px 12px; font-size: 15px;
    border: 1px solid #cbd5e1; border-radius: 8px;
    font-family: inherit; outline: none; margin-bottom: 12px;
    background: #f8fafc; color: #1e293b;
  }
  .modal-input:focus { border-color: #2563eb; background: #fff; }
  .modal-actions { display: flex; gap: 8px; justify-content: flex-end; }

  .history-list {
    max-height: 55vh; overflow-y: auto;
    margin-bottom: 12px; padding-right: 4px;
    -webkit-overflow-scrolling: touch;
  }
  .history-item {
    padding: 10px 12px; border-radius: 9px;
    background: #f8fafc; border: 1px solid #e2e8f0;
    margin-bottom: 8px; font-size: 12px;
  }
  .history-row1 {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 5px;
  }
  .history-seed {
    font-weight: 700; color: #1e3a8a;
    font-size: 13px; letter-spacing: .5px;
  }
  .history-tag {
    font-size: 10px; font-weight: 700;
    padding: 2px 7px; border-radius: 6px; letter-spacing: .5px;
  }
  .history-tag.success { background: #dcfce7; color: #16a34a; }
  .history-tag.ongoing { background: #fef3c7; color: #d97706; }
  .history-tag.practice { background: #e0e7ff; color: #4338ca; }
  .history-row2 {
    display: flex; justify-content: space-between;
    color: #64748b; font-size: 11px;
  }
  .history-state {
    color: #7c3aed; font-weight: 700;
    font-size: 11px; margin-top: 4px;
  }
  .history-duration {
    margin-top: 2px;
    font-size: 11px;
    font-weight: 700;
    color: #2563eb;
  }
  .history-empty {
    text-align: center; color: #94a3b8;
    padding: 24px 0; font-size: 13px;
  }

  .rank-subtitle {
    font-size: 11px; color: #94a3b8;
    text-align: center; margin: -6px 0 10px; letter-spacing: .5px;
  }
  .rank-tabs {
    display: flex; gap: 4px; margin-bottom: 12px;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    padding-bottom: 2px;
  }
  .rank-tab {
    flex: 1 0 auto;
    padding: 7px 8px; border-radius: 8px;
    border: 1px solid #cbd5e1; background: #fff;
    font-size: 11px; font-weight: 700; cursor: pointer;
    transition: all .15s; font-family: inherit;
    min-width: 52px; white-space: nowrap;
  }
  .rank-tab.active {
    background: #2563eb; color: #fff; border-color: #2563eb;
  }
  .rank-list {
