  function calcBest(arr) {
    if (!arr || arr.length === 0) return null;
    return Math.min(...arr);
  }
  function calcMO3(arr) {
    if (!arr || arr.length < 3) return null;
    let best = Infinity;
    for (let i = 0; i <= arr.length - 3; i++) {
      const group = arr.slice(i, i + 3);
      const avg = group.reduce((a, b) => a + b, 0) / 3;
      if (avg < best) best = avg;
    }
    return best;
  }
  function calcAO5(arr) {
    if (!arr || arr.length < 5) return null;
    let best = Infinity;
    for (let i = 0; i <= arr.length - 5; i++) {
      const group = arr.slice(i, i + 5).sort((a, b) => a - b);
      const trimmed = group.slice(1, 4);
      const avg = trimmed.reduce((a, b) => a + b, 0) / 3;
      if (avg < best) best = avg;
    }
    return best;
  }
  function calcAO12(arr) {
    if (!arr || arr.length < 12) return null;
    let best = Infinity;
    for (let i = 0; i <= arr.length - 12; i++) {
      const group = arr.slice(i, i + 12).sort((a, b) => a - b);
      const trimmed = group.slice(1, 11);
      const avg = trimmed.reduce((a, b) => a + b, 0) / 10;
      if (avg < best) best = avg;
    }
    return best;
  }

